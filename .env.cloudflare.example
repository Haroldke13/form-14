# Copy this file to .env.cloudflare and paste the tunnel token from
# Cloudflare One > Networks > Connectors > Cloudflare Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional second tunnel named "dummy tunnel" for research.harolditdata.uk.
CLOUDFLARE_DUMMY_TUNNEL_TOKEN=

# The launcher writes these values into local token files under .cloudflared/.
# Keep both .env.cloudflare and .cloudflared/ out of git.
